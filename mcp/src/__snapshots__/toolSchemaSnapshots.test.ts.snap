exports[`tool schema snapshots > mindvault_export_receipts > annotations 1`] = `
{
  "destructiveHint": false,
  "idempotentHint": true,
  "readOnlyHint": true,
  "title": "Export Receipts",
}
`;

exports[`tool schema snapshots > mindvault_export_receipts > input schema 1`] = `
{
  "properties": {
    "fields": {
      "description": "Comma-separated subset of row fields to include, in order. Defaults to every field except sensitive ones. Known fields: resourceId, title, amount, currency, network, purchasedAt, txHash, receiptRef, explorerUrl, profile. Selecting a sensitive field (profile) is an explicit opt-in.",
      "examples": [
        "resourceId,amount,purchasedAt",
        "resourceId,txHash,explorerUrl",
      ],
      "type": "string",
    },
    "format": {
      "description": "Output format. "json" (default) returns the receipts array; "csv" additionally renders the same rows as an RFC 4180 document in the envelope's csv field; "ndjson" renders each row as a JSON object on its own line in the envelope's ndjson field.",
      "enum": [
        "json",
        "csv",
        "ndjson",
      ],
      "examples": [
        "json",
        "csv",
        "ndjson",
      ],
      "type": "string",
    },
    "groupBy": {
      "description": "Optional grouping. Use "month" to include per-month receipt counts and USDC totals (UTC) in monthlySummaries.",
      "enum": [
        "month",
      ],
      "examples": [
        "month",
      ],
      "type": "string",
    },
    "includeSensitive": {
      "description": "When true, keep sensitive fields (profile) in the default field set. Has no effect when fields is given.",
      "examples": [
        false,
        true,
      ],
      "type": "boolean",
    },
    "limit": {
      "description": "Max receipts to export, newest first (1–500).",
      "examples": [
        50,
        100,
      ],
      "maximum": 500,
      "minimum": 1,
      "type": "integer",
    },
    "network": {
      "description": "Export only receipts settled on this x402 network id. Example: 'stellar:testnet'.",
      "examples": [
        "stellar:testnet",
        "stellar:pubnet",
      ],
      "type": "string",
    },
    "offset": {
      "description": "Rows to skip from the newest receipt, for resumable paging. The envelope's nextOffset is the value to pass here on the next call.",
      "examples": [
        0,
        500,
      ],
      "minimum": 0,
      "type": "integer",
    },
    "resourceId": {
      "description": "Export only receipts for this resource id.",
      "examples": [
        "cm7x8y9z",
        "swcn98besxpp6t1u8e77fqz3",
      ],
      "type": "string",
    },
    "since": {
      "description": "Inclusive lower bound on the purchase time (ISO-8601 date or timestamp; a bare date is read as midnight UTC).",
      "examples": [
        "2026-08-01",
        "2026-08-01T12:00:00Z",
      ],
      "type": "string",
    },
    "until": {
      "description": "Inclusive upper bound on the purchase time (ISO-8601 date or timestamp).",
      "examples": [
        "2026-08-31",
        "2026-08-31T23:59:59Z",
      ],
      "type": "string",
    },
  },
  "required": [],
  "type": "object",
}
`;

