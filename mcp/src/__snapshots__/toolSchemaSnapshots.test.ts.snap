exports[`tool schema snapshots > mindvault_registry_creator_page > input schema 1`] = `
{
  "properties": {
    "creator": {
      "description": "Stellar public key (G…) whose resources to list. The page covers this creator's inventory only.",
      "examples": [
        "GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5",
      ],
      "type": "string",
    },
    "cursor": {
      "description": "Opaque cursor from a previous page's nextCursor. Omit for the first page.",
      "examples": [
        "eyJ2IjoxLCJ0IjoiYSJ9",
      ],
      "type": "string",
    },
    "limit": {
      "description": "Page size (1–20, default 20). The contract caps higher values at 20.",
      "examples": [
        20,
        10,
      ],
      "maximum": 20,
      "minimum": 1,
      "type": "integer",
    },
    "listed": {
      "description": "Filter on the listing projection: true keeps only listed resources, false keeps only unlisted ones. Omit to keep every resource.",
      "examples": [
        true,
        false,
      ],
      "type": "boolean",
    },
    "state": {
      "description": "Filter on the lifecycle state. Omit to keep every state. Tombstoned resources are never returned, so that filter always yields an empty page.",
      "enum": [
        "Listed",
        "Delisted",
        "Frozen",
        "Disputed",
        "Tombstoned",
      ],
      "examples": [
        "Listed",
        "Frozen",
      ],
      "type": "string",
    },
  },
  "required": [
    "creator",
  ],
  "type": "object",
}
`;

