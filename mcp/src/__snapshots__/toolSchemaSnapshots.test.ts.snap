              "enum": [
                "confirmation_timeout",
                "rpc_unavailable",
              ],
              "type": "string",
            },
            "resourceId": {
              "type": "string",
            },
            "status": {
              "description": ""success" once settled on-chain; "submitted" when the transaction was accepted but its outcome could not be read (poll timeout or RPC outage) — check it with statusLookup instead of resubmitting.",
              "type": "string",
            },
            "statusLookup": {
              "properties": {
                "arguments": {
                  "properties": {
                    "txHash": {
                      "type": "string",
