exports[`tool schema snapshots > mindvault_buy_lease > annotations 1`] = `
{
  "destructiveHint": false,
  "idempotentHint": false,
  "readOnlyHint": false,
  "title": "Buy Access Lease",
}
`;

exports[`tool schema snapshots > mindvault_buy_lease > input schema 1`] = `
{
  "properties": {
    "confirmMainnet": {
      "description": "Required on mainnet (or set MINDVAULT_ALLOW_MAINNET=1). Explicitly confirm this payment on the public Stellar network.",
      "type": "boolean",
    },
    "confirmPaid": {
      "description": "Required when the server runs with MINDVAULT_CONFIRM_PAID_OPERATIONS=usdc or =all. Explicitly confirm that this call may spend from the agent wallet. Ignored when the policy is off (the default) and on dry runs.",
      "type": "boolean",
    },
    "dryRun": {
      "description": "Optional dry-run flag. When true, quotes the lease price and lists the steps without paying or writing on-chain.",
      "type": "boolean",
    },
    "maxAutoPayUsdc": {
      "description": "Explicit per-call maximum automatic payment in USDC. Required when the lease costs more than MINDVAULT_MAX_AUTO_PAY_USDC; must be at least the quoted price.",
      "examples": [
        "25.00",
      ],
      "type": "string",
    },
    "resourceId": {
      "description": "The resource ID to lease, from mindvault_browse or mindvault_search. Letters, digits, dot, dash, or underscore.",
      "examples": [
        "cm7x8y9z",
        "swcn98besxpp6t1u8e77fqz3",
      ],
      "type": "string",
    },
    "tier": {
      "description": "Lease duration tier: hour (720 ledgers, 1x price), day (17280 ledgers, 5x), or week (120960 ledgers, 20x).",
      "enum": [
        "hour",
        "day",
        "week",
      ],
      "examples": [
        "day",
      ],
      "type": "string",
    },
  },
  "required": [
    "resourceId",
    "tier",
  ],
  "type": "object",
}
`;

exports[`tool schema snapshots > mindvault_buy_lease > output schema 1`] = `
{
  "anyOf": [
    {
      "oneOf": [
        {
          "properties": {
            "confirmed": {
              "description": "true only when txPhase is "settled". Deprecated: prefer txPhase.",
              "type": "boolean",
            },
            "creator": {
              "type": "string",
            },
            "lease": {
              "properties": {
                "amountStroops": {
                  "type": "string",
                },
