exports[`tool schema snapshots > mindvault_registry_tag_search > input schema 1`] = `
{
  "properties": {
    "cursor": {
      "description": "Catalog index to resume from, as returned by a previous page's nextCursor. Omit for the first page.",
      "examples": [
        0,
        20,
      ],
      "minimum": 0,
      "type": "integer",
    },
    "limit": {
      "description": "Maximum number of resources to return (1–20, default 20). The contract clamps higher values at 20 and always returns at least one match so the scan keeps making progress.",
      "examples": [
        20,
        10,
      ],
      "maximum": 20,
      "minimum": 1,
      "type": "integer",
    },
    "prefix": {
