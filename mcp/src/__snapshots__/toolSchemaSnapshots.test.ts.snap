exports[`tool schema snapshots > mindvault_buy > annotations 1`] = `
{
  "destructiveHint": false,
  "idempotentHint": false,
  "readOnlyHint": false,
  "title": "Buy Resource",
}
`;

exports[`tool schema snapshots > mindvault_buy > input schema 1`] = `
{
  "properties": {
    "confirmMainnet": {
      "description": "Required on mainnet (or set MINDVAULT_ALLOW_MAINNET=1). Explicitly confirm this mutation/payment on the public Stellar network.",
      "type": "boolean",
    },
    "confirmPaid": {
      "description": "Required when the server runs with MINDVAULT_CONFIRM_PAID_OPERATIONS=usdc or =all. Explicitly confirm that this call may spend from the agent wallet. Ignored when the policy is off (the default) and on dry runs.",
      "type": "boolean",
    },
    "dryRun": {
      "description": "Optional dry-run flag. When true, validates the resource ID and shows intended network, endpoint, and required wallet state without submitting payment.",
      "type": "boolean",
    },
    "intervalMs": {
      "default": 2000,
      "description": "Optional interval in milliseconds between settlement status polls when wait is true. Default 2000, minimum 200.",
      "examples": [
        500,
        2000,
      ],
      "minimum": 200,
      "type": "integer",
    },
    "maxAutoPayUsdc": {
      "description": "Explicit per-call maximum automatic payment in USDC. Required when this resource costs more than MINDVAULT_MAX_AUTO_PAY_USDC; must be at least the advertised price.",
      "examples": [
        "25.00",
      ],
      "type": "string",
    },
    "resourceId": {
      "description": "The resource ID to buy, from mindvault_browse or mindvault_search. Letters, digits, dot, dash, or underscore.",
      "examples": [
        "cm7x8y9z",
        "swcn98besxpp6t1u8e77fqz3",
      ],
      "type": "string",
    },
    "timeoutMs": {
      "default": 60000,
      "description": "Optional deadline in milliseconds for settlement confirmation when wait is true. Default 60000, inclusive maximum 300000.",
      "examples": [
        30000,
        60000,
      ],
      "maximum": 300000,
      "minimum": 0,
      "type": "integer",
    },
    "wait": {
      "description": "Optional flag. When true, wait and poll the payment transaction on Soroban until it settles (SUCCESS or FAILED) or the timeout elapses, returning a settlement confirmation block. Off by default, in which case the buy returns as soon as the payment response arrives. Legacy shorthand for waitPolicy: "wait-for-final-result".",
      "type": "boolean",
    },
    "waitPolicy": {
      "description": "How long to wait for the payment transaction before returning. "return-after-submit" (default) returns as soon as the payment is submitted, reporting the tx hash and any status already known; "wait-for-final-result" polls until the transaction reaches a terminal status or timeoutMs elapses. Takes precedence over wait when both are set.",
      "enum": [
        "return-after-submit",
        "wait-for-final-result",
      ],
      "examples": [
        "return-after-submit",
        "wait-for-final-result",
      ],
      "type": "string",
    },
  },
  "required": [
    "resourceId",
  ],
  "type": "object",
}
`;

