exports[`tool schema snapshots > mindvault_terms > input schema 1`] = `
{
  "properties": {
    "confirmMainnet": {
      "description": "Required for set on mainnet (or set MINDVAULT_ALLOW_MAINNET=1).",
      "type": "boolean",
    },
    "confirmPaid": {
      "description": "Required when the server runs with MINDVAULT_CONFIRM_PAID_OPERATIONS=usdc or =all. Explicitly confirm that this call may spend from the agent wallet. Ignored when the policy is off (the default) and on dry runs.",
      "type": "boolean",
    },
    "creator": {
      "description": "Creator Stellar address to inspect. Optional for get when a wallet is active; set always uses the active wallet.",
      "type": "string",
    },
    "operation": {
      "description": "Whether to read or update the creator terms hash.",
      "enum": [
        "get",
        "set",
      ],
      "type": "string",
    },
    "termsHash": {
      "description": "Terms document hash or content-addressed digest to store (maximum 64 bytes). Required for set.",
      "examples": [
        "sha256:0123456789abcdef",
      ],
      "type": "string",
    },
  },
  "required": [
    "operation",
  ],
  "type": "object",
}
`;

