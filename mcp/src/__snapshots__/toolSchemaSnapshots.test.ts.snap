exports[`tool schema snapshots > mindvault_search > input schema 1`] = `
{
  "properties": {
    "bypassCache": {
      "description": "Fetch a fresh page for this call and report cacheStatus=bypassed. This does not disable or clear shared caching.",
      "type": "boolean",
    },
    "cursor": {
      "description": "Opaque cursor returned as nextCursor. It is valid only with the same profile, network, API origin, and filters; discard it after switching profiles or changing filters.",
      "type": "string",
    },
    "limit": {
      "description": "Max number of resources to return (1–100, server default 20).",
      "examples": [
        20,
        50,
      ],
      "maximum": 100,
      "minimum": 1,
      "type": "integer",
    },
    "listed": {
      "description": "Filter by listing state. The public catalog is listed=true only; listed=false yields no public catalog matches (use mindvault_registry_lookup for a specific resource).",
      "examples": [
        true,
        false,
      ],
      "type": "boolean",
    },
    "maxPrice": {
      "description": "Maximum USDC price to include (decimal string). Example: '20.00' excludes resources priced above 20 USDC.",
      "examples": [
        "20.00",
        "15.99",
        "100.00",
      ],
      "type": "string",
    },
    "minPrice": {
      "description": "Minimum USDC price to include (decimal string). Example: '5.00' includes resources priced 5 USDC and above.",
      "examples": [
        "5.00",
        "10.50",
        "0.50",
      ],
      "type": "string",
    },
    "offset": {
      "description": "Number of resources to skip for pagination.",
      "examples": [
        0,
        20,
      ],
      "minimum": 0,
      "type": "integer",
    },
    "owner": {
      "description": "Filter by publisher name or wallet address (case-insensitive substring). Example: 'Alice' or a G... Stellar address.",
      "examples": [
        "Alice",
        "GB6LGS25...",
      ],
      "type": "string",
    },
    "query": {
      "description": "Keyword(s) to match against resource title or description. Examples: 'Stellar tutorial', 'Soroban smart contracts', 'DeFi guide'",
      "examples": [
        "Stellar tutorial",
        "Soroban smart contracts",
        "DeFi guide",
      ],
      "type": "string",
    },
    "resourceType": {
      "description": "Filter by resource type. 'file' = downloadable file (PDF, ebook, etc.), 'link' = external URL to web content.",
      "enum": [
        "file",
        "link",
      ],
      "examples": [
        "link",
        "file",
      ],
      "type": "string",
    },
    "sort": {
      "description": "Sort order for results. Defaults to newest when omitted.",
      "enum": [
        "newest",
        "price_asc",
        "price_desc",
        "title",
      ],
      "examples": [
        "newest",
        "price_asc",
        "price_desc",
        "title",
      ],
      "type": "string",
    },
    "tags": {
      "description": "Comma-separated discovery tags; resources must include all listed tags (matched client-side against tag fields on results). Example: 'dataset,research'.",
      "examples": [
        "dataset",
        "dataset,research",
      ],
      "type": "string",
    },
    "verificationStatus": {
      "description": "Filter by verification status. 'verified' = passed AI originality check, 'pending' = awaiting verification, 'rejected' = failed check, 'skipped' = verification skipped.",
      "enum": [
        "pending",
        "verified",
        "rejected",
        "skipped",
      ],
      "examples": [
        "verified",
      ],
      "type": "string",
    },
  },
  "required": [],
  "type": "object",
}
`;

