exports[`tool schema snapshots > mindvault_register_onchain > input schema 1`] = `
{
  "properties": {
    "bypassCache": {
      "description": "Fetch fresh metadata for this call and report cacheStatus=bypassed without changing shared cache policy.",
      "type": "boolean",
    },
    "confirmMainnet": {
      "description": "Required on mainnet (or set MINDVAULT_ALLOW_MAINNET=1). Explicitly confirm this mutation/payment on the public Stellar network.",
      "type": "boolean",
    },
    "confirmPaid": {
      "description": "Required when the server runs with MINDVAULT_CONFIRM_PAID_OPERATIONS=usdc or =all. Explicitly confirm that this call may spend from the agent wallet. Ignored when the policy is off (the default) and on dry runs.",
      "type": "boolean",
    },
    "resourceId": {
      "description": "The resource ID to register on-chain (from mindvault_publish output). Must be verified and not already registered. Example: 'cm7x8y9z'",
      "examples": [
        "cm7x8y9z",
        "res-001",
        "ckx9j2h3f",
      ],
      "type": "string",
    },
  },
  "required": [
    "resourceId",
  ],
  "type": "object",
}
`;

